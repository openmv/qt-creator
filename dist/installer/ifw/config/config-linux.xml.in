<?xml version="1.0"?>
<Installer>
    <Name>{app_name}</Name>
    <Version>{version}</Version>
    <Title>{app_name} {display_version}</Title>
    <Publisher>OpenMV, LLC</Publisher>
    <ProductUrl>https://openmv.io</ProductUrl>

    <MaintenanceToolName>{app_cased_id}Uninstaller</MaintenanceToolName>
    <TargetDir>@homeDir@/{app_id}</TargetDir>
    <AdminTargetDir>/opt/{app_id}</AdminTargetDir>
    <ControlScript>controlscript.qs</ControlScript>
</Installer>
