<?xml version="1.0"?>
<Installer>
    <Name>{app_name}</Name>
    <Version>{version}</Version>
    <Title>{app_name} {display_version}</Title>
    <Publisher>OpenMV, LLC</Publisher>
    <ProductUrl>https://openmv.io</ProductUrl>

    <MaintenanceToolName>Uninstall {app_name}</MaintenanceToolName>
    <TargetDir>@homeDir@/Applications/{app_name}</TargetDir>
    <AllowSpaceInPath>true</AllowSpaceInPath>
    <ControlScript>controlscript.qs</ControlScript>
</Installer>
