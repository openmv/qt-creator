; Copyright 2025 OpenMV, LLC.

[Strings]
DriverPackageDisplayName="Pure Thermal OpenMV USB Driver"
ManufacturerName="OpenMV, LLC (http://www.openmv.io)"
ServiceName="USB RS-232 Emulation Driver"
description="Pure Thermal OpenMV USB COM Port"

[DefaultInstall]
CopyINF=openmv-pt.inf

[Version]
Class=Ports
ClassGuid={A39820D8-F5E9-410E-A4AB-278AF670EDC8}
Signature="$Windows NT$"
Provider=%ManufacturerName%
DriverPackageDisplayName=%DriverPackageDisplayName%
CatalogFile=openmv-pt.cat
DriverVer=09/09/2016,1.1.1.0

[Manufacturer]
%ManufacturerName%=DeviceList,NTamd64,NTia64,NTarm64

[DestinationDirs]
FakeModemCopyFileSection=12
DefaultDestDir=12

[DeviceList]
%description%=DriverInstall,USB\VID_37C5&PID_1205&MI_00,USB\VID_37C5&PID_1205&MI_01

[DeviceList.NTamd64]
%description%=DriverInstall,USB\VID_37C5&PID_1205&MI_00,USB\VID_37C5&PID_1205&MI_01

[DeviceList.NTia64]
%description%=DriverInstall,USB\VID_37C5&PID_1205&MI_00,USB\VID_37C5&PID_1205&MI_01

[DeviceList.NTarm64]
%description%=DriverInstall,USB\VID_37C5&PID_1205&MI_00,USB\VID_37C5&PID_1205&MI_01

[DriverInstall]
include=mdmcpq.inf,usb.inf
CopyFiles=FakeModemCopyFileSection
AddReg=DriverAddReg

[DriverAddReg]
HKR,,DevLoader,,*ntkern
HKR,,NTMPDriver,,usbser.sys
HKR,,EnumPropPages32,,"MsPorts.dll,SerialPortPropPageProvider"

[DriverInstall.Services]
include=mdmcpq.inf
AddService=usbser,0x00000002,DriverService

[DriverService]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\usbser.sys
LoadOrderGroup=Base
