; Copyright 2025 OpenMV, LLC.

[Strings]
DriverPackageDisplayName="OpenMV Cam H7 Plus USB Driver"
ManufacturerName="OpenMV, LLC (http://www.openmv.io)"
ServiceName="USB RS-232 Emulation Driver"
description="OpenMV Cam H7 Plus USB COM Port"

[DefaultInstall]
CopyINF=openmv-h7p.inf

[Version]
Class=Ports
ClassGuid={FE67C794-FD84-4846-8C27-419E243F5A89}
Signature="$Windows NT$"
Provider=%ManufacturerName%
DriverPackageDisplayName=%DriverPackageDisplayName%
CatalogFile=openmv-h7p.cat
DriverVer=09/09/2016,1.1.1.0

[Manufacturer]
%ManufacturerName%=DeviceList,NTamd64,NTia64,NTarm64

[DestinationDirs]
FakeModemCopyFileSection=12
DefaultDestDir=12

[DeviceList]
%description%=DriverInstall,USB\VID_37C5&PID_124A&MI_00,USB\VID_37C5&PID_124A&MI_01

[DeviceList.NTamd64]
%description%=DriverInstall,USB\VID_37C5&PID_124A&MI_00,USB\VID_37C5&PID_124A&MI_01

[DeviceList.NTia64]
%description%=DriverInstall,USB\VID_37C5&PID_124A&MI_00,USB\VID_37C5&PID_124A&MI_01

[DeviceList.NTarm64]
%description%=DriverInstall,USB\VID_37C5&PID_124A&MI_00,USB\VID_37C5&PID_124A&MI_01

[DriverInstall]
include=mdmcpq.inf,usb.inf
CopyFiles=FakeModemCopyFileSection
AddReg=DriverAddReg

[DriverAddReg]
HKR,,DevLoader,,*ntkern
HKR,,NTMPDriver,,usbser.sys
HKR,,EnumPropPages32,,"MsPorts.dll,SerialPortPropPageProvider"

[DriverInstall.Services]
include=mdmcpq.inf
AddService=usbser,0x00000002,DriverService

[DriverService]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\usbser.sys
LoadOrderGroup=Base
