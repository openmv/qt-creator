<RCC>
    <qresource prefix="/core">
    <!-- OPENMV-DIFF -->
    <!-- Upstream pulls the big logo (128 and 256) from QtProject-${IDE_ID}.png.
         OpenMV ships its own OpenMV-openmvide.png below instead. Do NOT keep the
         upstream entries as a commented-out block, and do not write a literal
         resource tag anywhere in this comment: CMake 4.x AutoRcc scans for such
         tags even inside XML comments and would demand the nonexistent
         QtProject-openmvide.png. -->
    <!-- OPENMV-DIFF -->
    <file alias="images/qtcreatorlogo-big.png">${IDE_LOGO_PATH}/images/logo/128/OpenMV-openmvide.png</file>
    <file alias="images/qtcreatorlogo-big@2x.png">${IDE_LOGO_PATH}/images/logo/256/OpenMV-openmvide.png</file>
    <!-- OPENMV-DIFF -->

    </qresource>
</RCC>
